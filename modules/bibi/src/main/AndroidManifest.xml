<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.brycewg.asrkb.permission.IME_BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.brycewg.asrkb.permission.IME_BRIDGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 经典蓝牙权限（仅在 Android 12 以下有效） -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ 运行时蓝牙连接权限（用于更稳定地选择通信设备）；缺失时功能会自动回退 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:ignore="MissingPermission" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 存储权限：用于剪贴板文件下载到 Download/BiBi 目录 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 针对数据同步/下载类型前台服务权限（兼容不存在时忽略） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:ignore="NewApi" />
    <!-- Android 14+ 针对悬浮球录音的麦克风前台服务权限（兼容不存在时忽略） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:ignore="NewApi" />
    <!-- Android 14+ 针对用户主动开启的悬浮球后台常驻服务用途（兼容不存在时忽略） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:ignore="NewApi" />
    <!-- 申请电池优化白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 悬浮球需要的系统悬浮窗权限（运行时在设置中授予） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 通知权限,用于显示悬浮球语音识别状态 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 若通过 ADB 授权可写入 Secure 设置，用于尝试自动开启无障碍（普通应用默认不会授予） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Shizuku 权限：用于在已授权时以 shell 身份执行部分系统命令 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      ! Library manifest merged into the host application (AutoJs6).
      ! Application-level attributes (name/label/icon/theme/backup/cleartext traffic, etc.) are owned by the host.
      ! FileProvider and ShizukuProvider are owned by the host (identical authorities:
      !   ${applicationId}.fileprovider and ${applicationId}.shizuku), so they are NOT declared here.
      ! SettingsActivity is launched only via explicit Intent (no launcher entry).
      ! zh-CN: 库 manifest, 合并入宿主应用 (AutoJs6).
      ! application 级属性 (name/label/icon/theme/备份/明文流量等) 由宿主持有.
      ! FileProvider 与 ShizukuProvider 由宿主持有 (authority 与原 BiBi 一致), 此处不再声明.
      ! SettingsActivity 仅通过显式 Intent 启动 (无桌面入口).
    -->
    <application>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.setup.OnboardingGuideActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 外部兼容跳转页 -->
        <activity
            android:name=".ui.settings.asr.AsrRecognitionSettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.settings.asr.LargePromptEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".ime.AsrKeyboardService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@style/Theme.ASRKeyboard.Ime"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>


        <!-- 悬浮球语音识别服务 -->
        <service
            android:name=".ui.floating.FloatingAsrService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".ui.floating.FloatingImeBridgeHintReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.brycewg.asrkb.imebridge.action.IME_WINDOW_VISIBILITY_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 悬浮球前台保活服务 -->
        <service
            android:name=".ui.floating.FloatingKeepAliveService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_enabled_floating_keyboard_keep_alive" />
        </service>

        <!-- Shizuku / root 增强保活：周期性拉起前台保活服务 -->
        <service
            android:name=".ui.floating.PrivilegedKeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 模型下载/解压前台服务（支持并发任务） -->
        <service
            android:name=".ui.settings.asr.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 无障碍服务,用于文本插入 -->
        <service
            android:name=".ui.AsrAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机启动接收器：根据偏好启动悬浮服务，并在具备权限时尝试开启无障碍 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>


    <queries>
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

</manifest>
